<?xml version="1.0"?>
<ruleset name="RouteMaps">
    <description>RouteMaps WordPress coding standards.</description>
    <file>routemaps.php</file>
    <file>src</file>
    <file>tests</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>
    <!-- The approved architecture uses PSR-4 class files and camelCase public contracts. -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
        <severity>0</severity>
    </rule>
</ruleset>
