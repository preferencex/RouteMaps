includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - src
    tmpDir: .phpstan-cache

    # WordPress/WooCommerce APIs carry PHPDoc that is sometimes narrower than
    # the runtime contracts accepted by plugin integrations.
    treatPhpDocTypesAsCertain: false

    # These are synthetic contracts for APIs/constants that are not installed
    # through Composer in the analysis environment. They must be scanned as
    # source symbols rather than treated as overrides for already-known symbols.
    scanFiles:
        - phpstan-stubs/woocommerce.stub.php
        - phpstan-stubs/routemaps.stub.php

    # Generic iterable annotations are being tightened incrementally. Keep
    # level 6 for all other type/flow checks during the Core release gate.
    ignoreErrors:
        -
            identifier: missingType.iterableValue
